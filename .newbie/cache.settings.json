{
  "config-service": {
    "cache": {
      "memory": {
        "ttl": 3600000,
        "lruSize": 1000
      },
      "redis": {
        "ttl": 86400000,
        "host": "process.env.CACHE_REDIS_HOST",
        "port": "int(process.env.CACHE_REDIS_PORT, 6379)",
        "user": "process.env.CACHE_REDIS_USER",
        "password": "process.env.CACHE_REDIS_PASSWORD"
      }
    }
  },
  "env": {
    "CACHE_REDIS_HOST": "localhost",
    "CACHE_REDIS_PORT": "6379",
    "CACHE_REDIS_USER": "",
    "CACHE_REDIS_PASSWORD": ""
  },
  "dependencies": {
    "@keyv/redis": "^5.1.4",
    "@nestjs/cache-manager": "^3.0.1",
    "cache-manager": "^7.2.5",
    "cacheable": "^2.3.0",
    "keyv": "^5.5.4"
  },
  "devDependencies": {
    "@types/cache-manager": "^5.0.0"
  }
}
